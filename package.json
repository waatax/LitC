{
  "name": "litc-classicflow",
  "private": true,
  "version": "0.1.0",
  "description": "經典文脈 ClassicFlow — 先秦諸子經典背誦學習系統",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run audit:traditional && vue-tsc -b && vite build",
    "deploy": "npm run build && gh-pages -d dist",
    "preview": "vite preview",
    "audit:corpus": "node scripts/audit_editorial_quality.mjs",
    "audit:completeness": "node scripts/audit_editorial_quality.mjs --strict",
    "audit:editorial": "node scripts/audit_editorial_quality.mjs",
    "audit:traditional": "node scripts/audit_traditional_chinese.js",
    "editorial:baseline": "node scripts/audit_editorial_quality.mjs",
    "editorial:gate": "node scripts/audit_editorial_quality.mjs --strict",
    "editorial:verify": "npm run audit:traditional && node scripts/audit_editorial_quality.mjs && vue-tsc -b",
    "editorial:release": "npm run editorial:gate && npm run build",
    "normalize:traditional": "node scripts/normalize_traditional_chinese.js",
    "quality": "npm run audit:traditional && node scripts/audit_editorial_quality.mjs --strict && vue-tsc -b",
    "improve": "node --env-file=.env scripts/ai_improve_reading_aids.js"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "dexie": "^4.4.4",
    "pinia": "^3.0.2",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "gh-pages": "^6.3.0",
    "opencc-js": "^1.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.8"
  }
}
