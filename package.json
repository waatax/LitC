{
  "name": "litc-classicflow",
  "private": true,
  "version": "0.1.0",
  "description": "經典文脈 ClassicFlow — 先秦諸子經典背誦學習系統",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run audit:traditional && vue-tsc -b && vite build",
    "preview": "vite preview",
    "audit:corpus": "node scripts/audit_corpus_quality.js",
    "audit:completeness": "node scripts/verify_translation_completeness_v2.js",
    "audit:traditional": "node scripts/audit_traditional_chinese.js",
    "normalize:traditional": "node scripts/normalize_traditional_chinese.js",
    "quality": "node scripts/quality_gate.js",
    "improve": "node --env-file=.env scripts/ai_improve_reading_aids.js"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "dexie": "^4.4.4",
    "pinia": "^3.0.2",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "gh-pages": "^6.3.0",
    "opencc-js": "^1.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.8"
  }
}
